{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keues TicketMachine",
  "version": "../package.json",
  "identifier": "com.keues.ticketmachine",

  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:11223",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keues TicketMachine",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },

  "bundle": {
    "active": true,

    "targets": [
      "nsis",
      "appimage"
    ],

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "createUpdaterArtifacts": true,

    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNDYwMDhEQjA2OTQzRDgKUldUWVEybXdqUUJHYy9RUEp5NWNmSzFwRnRvb2FMaEU2V3k5b05uRGQ3WTdQRjg3T2s1cDEyckQK",

      "endpoints": [
        "https://github.com/HastaCs/Keues-TicketMachine/releases/latest/download/latest.json"
      ],

      "windows": {
        "installMode": "passive"
      }
    }
  }
}